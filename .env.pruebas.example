# Base de pruebas: copia este archivo a .env.pruebas (no se versiona).
# Lo leen `npm run verificar:*` y `npm run dev:pruebas`.
# NUNCA pongas acá las llaves de producción: los scripts se niegan a correr.

# Dashboard del proyecto de PRUEBAS → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_URL=http://localhost:3000

# Llave de prueba, distinta de la de producción (32 bytes en base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MP_TOKENS_KEY=

# Opcional: la app de MP del integrador de prueba. Sin esto, el canje de tokens
# no llega a MP y los casos que lo necesitan toman su rama "sin secreto".
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Secreto de los crons para las pruebas (verificar:cobro llama a
# /api/cron/correos). Distinto del de producción: cualquier texto aleatorio.
CRON_SECRET=

# RESEND_API_KEY no va acá: npm run dev:pruebas la deja vacía siempre.
