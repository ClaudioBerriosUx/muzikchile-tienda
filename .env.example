NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase del CHANNEL (proyecto DISTINTO al de la Tienda) ──────────────────
# La portada (/) lee los videos destacados desde el Supabase del Channel, que es
# otro proyecto con su propia URL y su propia anon key.
#
# De dónde sacarlas: dashboard de Supabase del proyecto del Channel →
# Project Settings → API → "Project URL" y "Project API keys → anon public".
# (Si el Channel se administra desde Lovable, están en las env vars de ese
# proyecto, con estos nombres o equivalentes.)
#
# Son claves PÚBLICAS: viajan al navegador, por eso el prefijo NEXT_PUBLIC_.
# NO poner acá la service role del Channel.
#
# Si faltan, la portada renderiza igual: la sección de videos muestra un aviso
# de configuración pendiente en vez de romperse.
NEXT_PUBLIC_CHANNEL_SUPABASE_URL=
NEXT_PUBLIC_CHANNEL_SUPABASE_ANON_KEY=

# ── Mercado Pago marketplace (conexión de cuentas de artistas) ───────────────
# Solo servidor: ninguna lleva NEXT_PUBLIC_.
#
# MP_CLIENT_ID      Client ID de la aplicación de MP (Tus integraciones).
# MP_CLIENT_SECRET  Client Secret de esa aplicación. Nunca en el repo.
# MP_TOKENS_KEY     Llave AES-256 para cifrar los tokens de los artistas:
#                   32 bytes aleatorios en base64. Generarla con
#                   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#                   Si se pierde o cambia, hay que reconectar todas las cuentas.
# CRON_SECRET       Lo manda Vercel al cron /api/cron/mp-renovar. Cualquier
#                   texto largo aleatorio.
# MP_WEBHOOK_SECRET Clave secreta de los webhooks (Tus integraciones → la app →
#                   Webhooks). Verifica el header x-signature de los avisos
#                   (fase 1: solo se anota en el log). Admite varias separadas
#                   por coma (modo de prueba y productivo, o una rotación).
#                   Solo en Production; en local no hace falta.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_TOKENS_KEY=
CRON_SECRET=
MP_WEBHOOK_SECRET=
